generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://juanchi:JT%2375gka3YR@localhost:5432/canales-digitales"
}

model Channel {
  id              String  @id @default(uuid())
  name            String
  handle          String
  subscriberCount Int
  videoCount      Int
  viewCount       BigInt
  videos          Video[]
}

model Video {
  id           String    @id @default(uuid())
  title        String
  publishedAt  DateTime
  viewCount    BigInt
  likeCount    Int
  commentCount Int
  duration     String
  channelId    String
  channel      Channel   @relation(fields: [channelId], references: [id])
  thumbnail    String
  description  String
  comments     Comment[]
}

model Comment {
  id               String @id @default(uuid())
  textDisplay      String
  authorChannelUrl String
  authorChannelId  String
  videoId          String
  video            Video  @relation(fields: [videoId], references: [id])
}
