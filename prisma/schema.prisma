generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://juanignaciocuiule@localhost:5432/canales-digitales-2024"
}

model Channel {
  id String @id

  name        String
  handle      String
  description String
  publishedAt DateTime
  thumbnail   String   @default("")
  banner      String   @default("")

  viewCount       BigInt
  subscriberCount Int
  videoCount      Int

  videos   Video[]
  comments Comment[]

  @@index([handle], name: "idx_channel_handle")
  @@index([publishedAt], name: "idx_channel_publishedAt")
}

model Video {
  id        String @id @default(uuid())
  channelId String

  title       String
  description String
  publishedAt DateTime
  thumbnail   String   @default("")
  duration    Int

  viewCount    BigInt @default(0)
  likeCount    Int    @default(0)
  commentCount Int    @default(0)

  comments Comment[]

  channel Channel @relation(fields: [channelId], references: [id])

  @@index([channelId], name: "idx_video_channelId")
  @@index([publishedAt], name: "idx_video_publishedAt")
}

model Comment {
  id        String @id
  channelId String
  videoId   String
  authorId  String

  text             String
  publishedAt      DateTime
  videoPublishedAt DateTime
  likeCount        Int      @default(0)

  author  Author  @relation(fields: [authorId], references: [id])
  video   Video   @relation(fields: [videoId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@index([channelId], name: "idx_comment_channelId")
  @@index([videoId], name: "idx_comment_videoId")
  @@index([authorId], name: "idx_comment_authorId")
  @@index([publishedAt], name: "idx_comment_publishedAt")
  @@index([videoPublishedAt], name: "idx_comment_videoPublishedAt")
}

model Author {
  id String @id

  name   String
  avatar String

  Comment Comment[]
}
